{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Optimizer System",
  "version": "0.8.0",
  "identifier": "local.optimizer.desktop",
  "build": {
    "beforeBuildCommand": "npm.cmd run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Optimizer System",
        "decorations": false,
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "capabilities": ["main-local"],
      "csp": "default-src 'self'; script-src 'self'; img-src 'self' asset: data:; style-src 'self'; connect-src ipc: http://ipc.localhost http://tauri.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "",
      "endpoints": []
    }
  }
}
