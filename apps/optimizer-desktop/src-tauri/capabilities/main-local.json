{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-local",
  "description": "Local bundled editor access to auditable operations and provider credential management.",
  "windows": ["main"],
  "permissions": [
    "allow-project-session",
    "allow-workspace-read",
    "allow-workspace-write",
    "allow-version-read",
    "allow-version-write",
    "allow-operation-write",
    "allow-operation-audit-read",
    "allow-provider-secret-manage"
  ]
}
